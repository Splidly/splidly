{
  "name": "@splidly/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/router.ts"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "LOG_FORMAT=${LOG_FORMAT:-pretty} node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "security:encrypt-oauth-tokens": "tsx --env-file-if-exists=../../.env src/encrypt-oauth-tokens.ts",
    "security:configure-runtime-database": "tsx --env-file-if-exists=../../.env src/configure-runtime-database.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.16",
    "@hono/node-server": "2.1.6",
    "@splidly/db": "workspace:*",
    "@splidly/shared": "workspace:*",
    "@trpc/server": "11.24.0",
    "better-auth": "1.7.16",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "superjson": "2.2.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "tsdown": "0.23.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
