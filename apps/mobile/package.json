{
  "name": "@splidly/mobile",
  "private": true,
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build": "expo export --platform all --output-dir dist",
    "config:production:ios": "pnpm dlx eas-cli@27.4.1 env:exec production 'pnpm dlx eas-cli@27.4.1 config --platform ios --profile production --non-interactive'",
    "config:production:android": "pnpm dlx eas-cli@27.4.1 env:exec production 'pnpm dlx eas-cli@27.4.1 config --platform android --profile production --non-interactive'",
    "build:production": "pnpm run build:production:ios",
    "build:production:ios": "pnpm dlx eas-cli@27.4.1 env:exec production 'pnpm dlx eas-cli@27.4.1 build --platform ios --profile production'",
    "build:production:android": "pnpm dlx eas-cli@27.4.1 env:exec production 'pnpm dlx eas-cli@27.4.1 build --platform android --profile production'",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "submit:ios": "pnpm dlx eas-cli@27.4.1 env:exec production 'pnpm dlx eas-cli@27.4.1 submit --platform ios --profile production --latest'"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.18",
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~58.0.27",
    "@react-native-google-signin/google-signin": "17.0.0",
    "@splidly/server": "workspace:*",
    "@splidly/shared": "workspace:*",
    "@tanstack/react-query": "5.105.3",
    "@trpc/client": "11.24.0",
    "@trpc/react-query": "11.24.0",
    "better-auth": "1.7.18",
    "expo": "~58.0.23",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "superjson": "2.2.6"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
