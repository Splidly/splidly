{
  "name": "@splidly/mobile",
  "private": true,
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build": "expo export --platform all --output-dir dist",
    "config:production:ios": "pnpm dlx eas-cli@22.0.0 env:exec production 'pnpm dlx eas-cli@22.0.0 config --platform ios --profile production --non-interactive'",
    "config:production:android": "pnpm dlx eas-cli@22.0.0 env:exec production 'pnpm dlx eas-cli@22.0.0 config --platform android --profile production --non-interactive'",
    "build:production": "pnpm run build:production:ios",
    "build:production:ios": "pnpm dlx eas-cli@22.0.0 env:exec production 'pnpm dlx eas-cli@22.0.0 build --platform ios --profile production'",
    "build:production:android": "pnpm dlx eas-cli@22.0.0 env:exec production 'pnpm dlx eas-cli@22.0.0 build --platform android --profile production'",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "submit:ios": "pnpm dlx eas-cli@22.0.0 env:exec production 'pnpm dlx eas-cli@22.0.0 submit --platform ios --profile production --latest'"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.2",
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~57.0.14",
    "@react-native-google-signin/google-signin": "16.1.4",
    "@splidly/server": "workspace:*",
    "@splidly/shared": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "better-auth": "1.7.2",
    "expo": "~57.0.18",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.2",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.12.1",
    "superjson": "2.2.6"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
