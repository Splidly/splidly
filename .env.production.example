APP_DOMAIN=splidly.site
API_BIND_PORT=4000
NODE_ENV=production
LOG_FORMAT=json
LOG_LEVEL=info

POSTGRES_USER=splidly
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_RUNTIME_USER=splidly_app
POSTGRES_RUNTIME_PASSWORD=replace-with-a-different-long-random-password
POSTGRES_DB=splidly

BETTER_AUTH_SECRET=replace-with-at-least-43-high-entropy-characters

APPLE_SIGN_IN_CLIENT_ID=replace-with-apple-services-id
APPLE_SIGN_IN_KEY_ID=replace-key-id
APPLE_SIGN_IN_PRIVATE_KEY_FILE=/etc/splidly/secrets/apple-sign-in.p8

APNS_ENVIRONMENT=production
APNS_KEY_ID=replace-key-id
APNS_PRIVATE_KEY_FILE=/etc/splidly/secrets/apns-production.p8

GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-web-client-secret

IOS_APP_ID=com.example.splidly
IOS_TEAM_ID=replace-team-id

ANDROID_ENABLED=false
ANDROID_PACKAGE=
ANDROID_SHA256_FINGERPRINT=

IOS_STORE_URL=https://apps.apple.com/app/id000000000
ANDROID_STORE_URL=

# These details are published at /legal and /privacy. Use a serviceable street
# address, not a post-office box. Set registry and VAT fields if applicable.
LEGAL_NAME=replace-with-operator-or-company-name
LEGAL_STREET_ADDRESS=replace-with-street-and-house-number
LEGAL_POSTAL_CODE=replace-with-postal-code
LEGAL_LOCALITY=replace-with-city
LEGAL_COUNTRY=Germany
LEGAL_EMAIL=replace-with-monitored-email
LEGAL_PHONE=replace-with-public-phone-number
PRIVACY_EMAIL=replace-with-monitored-privacy-email
ABUSE_EMAIL=replace-with-monitored-abuse-email
# The repository does not install or schedule backups automatically. Leave this
# false unless the optional backup timer or another verified system is active.
BACKUPS_ENABLED=false
OFFSITE_BACKUP_PROVIDER=
OFFSITE_BACKUP_COUNTRY=
# Set 0 if Splidly retains no raw edge logs. Maximum accepted value is 30.
EDGE_LOG_RETENTION_DAYS=0
LEGAL_REPRESENTATIVE=
LEGAL_REGISTRY_NAME=
LEGAL_REGISTRY_NUMBER=
LEGAL_VAT_ID=

EXPO_PUBLIC_API_URL=https://splidly.site
EXPO_PUBLIC_APP_URL=https://splidly.site
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace-with-google-web-client-id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=replace-with-google-ios-client-id
GOOGLE_IOS_REVERSED_CLIENT_ID=replace-with-reversed-google-ios-client-id
