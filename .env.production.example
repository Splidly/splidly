APP_DOMAIN=splidly.example.com
API_BIND_PORT=4000

POSTGRES_USER=splidly
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=splidly

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

APPLE_SIGN_IN_CLIENT_ID=com.example.splidly.signin
APPLE_SIGN_IN_KEY_ID=KEYID
APPLE_SIGN_IN_PRIVATE_KEY_FILE=/etc/splidly/secrets/apple-sign-in.p8

APNS_ENVIRONMENT=production
APNS_KEY_ID=KEYID
APNS_PRIVATE_KEY_FILE=/etc/splidly/secrets/apns-production.p8

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

IOS_APP_ID=com.example.splidly
IOS_TEAM_ID=TEAMID

ANDROID_PACKAGE=com.example.splidly
ANDROID_SHA256_FINGERPRINT=

IOS_STORE_URL=https://apps.apple.com/app/id000000000
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.example.splidly
